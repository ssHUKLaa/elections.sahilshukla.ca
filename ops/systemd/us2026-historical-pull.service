[Unit]
Description=2026 election forecast historical data refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=forecast
Group=forecast
WorkingDirectory=/opt/us2026forecast
ExecStart=/opt/us2026forecast/.venv/bin/python pipeline/run_stage1_pull.py --include-historical
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/us2026forecast/data/raw /opt/us2026forecast/data/processed

[Install]
WantedBy=multi-user.target
