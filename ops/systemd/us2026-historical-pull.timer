[Unit]
Description=Weekly 2026 election forecast historical data refresh

[Timer]
# Historical inputs need no refresh after the final pre-election nowcast.
OnCalendar=2026-10-04 08:20:00 UTC
OnCalendar=2026-10-11 08:20:00 UTC
OnCalendar=2026-10-18 08:20:00 UTC
OnCalendar=2026-10-25 08:20:00 UTC
OnCalendar=2026-11-01 08:20:00 UTC
Persistent=false
RandomizedDelaySec=30m
Unit=us2026-historical-pull.service

[Install]
WantedBy=timers.target
